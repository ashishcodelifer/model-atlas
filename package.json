{
  "name": "model-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive Cytoscape.js atlas of AI model pricing, merged live from OpenRouter, models.dev and Hugging Face.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node server/index.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "snapshot": "node scripts/snapshot.mjs",
    "check:normalize": "node scripts/check-normalize.mjs"
  },
  "dependencies": {
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "cytoscape": "^3.33.0",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
